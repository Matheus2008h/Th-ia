{
  "name": "th-ia-backend",
  "version": "1.0.0",
  "description": "TH IA (TH-5.5) - Backend API",
  "main": "dist/server.js",
  "scripts": {
    "dev": "nodemon --watch src --ext ts --exec ts-node -r tsconfig-paths/register src/server.ts",
    "build": "tsc -p tsconfig.json && tsc-alias -p tsconfig.json",
    "start": "node dist/server.js",
    "pm2:start": "pm2 start dist/server.js --name th-ia-backend",
    "migrate": "ts-node -r tsconfig-paths/register src/database/migrate.ts",
    "lint": "eslint src --ext .ts"
  },
  "_moduleAliases": {
    "@config": "dist/config",
    "@controllers": "dist/controllers",
    "@services": "dist/services",
    "@middlewares": "dist/middlewares",
    "@routes": "dist/routes",
    "@sockets": "dist/sockets",
    "@utils": "dist/utils",
    "@types": "dist/types"
  },
  "dependencies": {
    "bcrypt": "^5.1.1",
    "mammoth": "^1.7.2",
    "mathjs": "^13.0.0",
    "otplib": "^12.0.1",
    "pdf-parse": "^1.1.1",
    "qrcode": "^1.5.3",
    "tesseract.js": "^5.1.0",
    "xlsx": "^0.18.5",
    "module-alias": "^2.2.3",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.2.0",
    "helmet": "^7.1.0",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "mysql2": "^3.10.0",
    "socket.io": "^4.7.5",
    "swagger-ui-express": "^5.0.0",
    "uuid": "^9.0.1",
    "winston": "^3.13.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/compression": "^1.7.5",
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.12.12",
    "@types/pdf-parse": "^1.1.4",
    "@types/qrcode": "^1.5.5",
    "@types/swagger-ui-express": "^4.1.6",
    "@types/uuid": "^9.0.8",
    "nodemon": "^3.1.0",
    "tsc-alias": "^1.8.10",
    "tsconfig-paths": "^4.2.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.5"
  }
}
