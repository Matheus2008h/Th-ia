# ==============================
# TH IA (TH-5.5) - Backend ENV
# ==============================

# App
NODE_ENV=development
PORT=4000
APP_URL=http://localhost:4000
FRONTEND_URL=http://localhost:3000
# Em produção com domínio (ver Caddyfile), troque para:
# APP_URL=https://api.seudominio.com
# FRONTEND_URL=https://seudominio.com

# JWT
JWT_SECRET=change_this_super_secret_key
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=change_this_other_secret_key
JWT_REFRESH_EXPIRES_IN=30d

# Usada para criptografar (AES-256-GCM) as API keys dos provedores de IA salvas no banco.
# Se não definida, usa o JWT_SECRET como base — recomenda-se definir uma própria em produção.
ENCRYPTION_KEY=change_this_encryption_key

# MySQL
DB_HOST=mysql
DB_PORT=3306
DB_USER=thia
DB_PASSWORD=thia_password
DB_NAME=th_ia
DB_CONNECTION_LIMIT=10

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# Admin (criado apenas na primeira instalação)
ADMIN_NAME=Administrador
ADMIN_EMAIL=admin@thia.local
ADMIN_PASSWORD=change_this_password

# Licenciamento / Contato para venda de Premium
PREMIUM_PRICE=R$15/mês
PREMIUM_WHATSAPP_NUMBER=5511942945429
PREMIUM_WHATSAPP_MESSAGE=Olá Theus, quero adquirir o premium do TH IA (TH-5.5)
PREMIUM_KEY_DURATION_DAYS=30

# Free plan
FREE_MESSAGE_LIMIT=15
FREE_MESSAGE_WINDOW_HOURS=5

# Providers de IA (opcionais, configurados também via painel admin)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
MISTRAL_API_KEY=
DEEPSEEK_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# Uploads
UPLOAD_MAX_SIZE_MB=50
UPLOAD_DIR=./uploads
